<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalonia_TestManagerForBKStudia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Avalonia_TestManagerForBKStudia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
		
		xmlns:viewsUserControl = "clr-namespace:Avalonia_TestManagerForBKStudia.Views"
		xmlns:viewModelsUserControl = "clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels.UserControls"
		
		
        Title="Avalonia_TestManager" MinHeight="450" MinWidth="1000">



	<Grid x:DataType="viewModelsWindow:MainWindowViewModel">
		<ContentControl  Content="{Binding CurrentViewModel}"/>
	</Grid>


	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type viewModelsUserControl:MenuViewModel}">
			<viewsUserControl:MenuUserControl/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewModelsUserControl:CreateTestViewModel}">
			<viewsUserControl:CreateTestUserControl/>
		</DataTemplate>	
	</Window.DataTemplates>

</Window>
