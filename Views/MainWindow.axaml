<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Avalonia_TestManagerForBKStudia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Avalonia_TestManagerForBKStudia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
		
		xmlns:views = "clr-namespace:Avalonia_TestManagerForBKStudia.Views.UserControls"
		xmlns:viewModels = "clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels.UserControls"
		xmlns:viewModelsWindow="clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels"
		
		
        Title="Avalonia_TestManager" MinHeight="450" MinWidth="1000">



	<Grid x:DataType="viewModelsWindow:MainWindowViewModel">
		<ContentControl  Content="{Binding CurrentViewModel}"/>
	</Grid>


	<Window.DataTemplates>
		<DataTemplate DataType="{x:Type viewModels:CreateTestViewModel}">
			<views:CreateTestView/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewModels:MainMenuViewModel}">
			<views:MainMenuView/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewModels:ChooseTestViewModel}">
			<views:ChooseTestView/>
		</DataTemplate>
	</Window.DataTemplates>

</Window>
