<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Avalonia_TestManagerForBKStudia.Views.UserControls.ChooseTestView">
	
	<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">

		<Interaction.Behaviors>
			<EventTriggerBehavior EventName="Loaded">
				<InvokeCommandAction Command="{Binding ScrollViewerLoadedCommand}"/>
			</EventTriggerBehavior>
		</Interaction.Behaviors>

		<ItemsControl Background="LightGray" ItemsSource="{Binding Tests, Mode=TwoWay}" ItemTemplate="{StaticResource TestTamplate}"/>
	</ScrollViewer>

	<UserControl.Resources>
		<DataTemplate x:Key="TestTamplate">

			<Grid Margin="10 15" Background="White" ColumnDefinitions="*,auto">
				<StackPanel Grid.Column="0" Orientation="Vertical">
					<TextBlock FontSize="17" Text="{Binding Name}"/>
					<TextBlock FontSize="13" Text="{Binding Path}"/>
				</StackPanel>
				<StackPanel Grid.Column="1">
					<Button Command="{Binding Path=DataContext.ChooseTestCommand, 
							RelativeSource={RelativeSource AncestorType=UserControl}}"
							CommandParameter="{Binding}">Выбрать</Button>
				</StackPanel>
			</Grid>

		</DataTemplate>
	</UserControl.Resources>
</UserControl>
