<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Avalonia_TestManagerForBKStudia.Views.UserControls.MainMenuView"
			 
			 xmlns:viewModels = "clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels.UserControls">
	
	<Grid x:DataType="viewModels:MainMenuViewModel">
		<Button Content="To Create" Command="{Binding NavigateToCreateTestCommand}"></Button>
	</Grid>
</UserControl>
