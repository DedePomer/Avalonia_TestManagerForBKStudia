<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Avalonia_TestManagerForBKStudia.Views.UserControls.MainMenuView"
			 
			 xmlns:viewModels = "clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels.UserControls">

			<Grid x:DataType="viewModels:MainMenuViewModel" RowDefinitions="*,auto,*">

				<StackPanel  HorizontalAlignment="Center" Grid.Row="1">

					<StackPanel HorizontalAlignment="Center">
						<Button Command="{Binding NavigateToChooseTestCommand}" Margin="0 10" Content="Выбрать тест"/>
					</StackPanel>

					<StackPanel HorizontalAlignment="Center">
						<Button Command="{Binding NavigateToCreateTestCommand}" Margin="0 10" Content="Создать тест"/>
					</StackPanel>

					<StackPanel  HorizontalAlignment="Center">
						<Button Command="{Binding ExitCommand}" Margin="0 10" Content="Выход"/>
					</StackPanel>

				</StackPanel>

			</Grid>
</UserControl>
