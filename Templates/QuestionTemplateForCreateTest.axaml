<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					
					xmlns:views = "clr-namespace:Avalonia_TestManagerForBKStudia.Views.UserControls"
					xmlns:viewModels = "clr-namespace:Avalonia_TestManagerForBKStudia.ViewModels.UserControls"
					xmlns:dataTypes = "clr-namespace:Avalonia_TestManagerForBKStudia.Models.UserDataTypes">
  
<!--Шаблон для вопроса с ответом в виде текста-->
	<DataTemplate  x:Key="CreateTest_QuestionWithTextAnswerTemplate">

		<Border x:DataType="dataTypes:QuestionWithTextAnswer" Margin="10" Background="White" BorderBrush="Black" BorderThickness="1">
			<Grid ColumnDefinitions="*,auto" RowDefinitions="*,auto" >

				<StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" >
					<Label ToolTip.Tip="Вопрос"></Label>
					<TextBox Width="200" Text="{Binding Text, Mode=TwoWay}"></TextBox>
				</StackPanel>

				<StackPanel Margin="0 0 0 20"  Grid.Column="0" Grid.Row="1" Orientation="Horizontal" >
					<Label ToolTip.Tip="Ответ"></Label>
					<TextBox x:DataType="dataTypes:TextAnswer" Width="200" Text="{Binding Text, Mode=TwoWay}"></TextBox>
				</StackPanel>


				<StackPanel  Grid.Column="1" Grid.Row="1" Margin="0 0 10 20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" >
					<Button Command="{Binding DataContext.DeleteQuestionCommand,
								 RelativeSource={RelativeSource AncestorType=UserControl}}"
								CommandParameter="{Binding}" Background="Red">Удалить</Button>
				</StackPanel>

			</Grid>
		</Border>
		
	</DataTemplate>

	<!--Шаблон для вопроса с несколькими вариантами ответа, 1 из которых верный-->
	<DataTemplate  x:Key="CreateTest_MultipleChoiceQuestionWithOneAnswerTemplate">

		<Border Margin="10" Background="White" BorderBrush="Black" BorderThickness="1">
			<Grid ColumnDefinitions="*,auto" RowDefinitions="*,auto" >

				<StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" >
					<Label ToolTip.Tip="Вопрос"></Label>
					<TextBox x:DataType="dataTypes:MultipleChoiceQuestionWithOneAnswer" Width="200" Text="{Binding Text, Mode=TwoWay}"></TextBox>
				</StackPanel>
				
				<StackPanel  Grid.Column="0" Grid.Row="1" Orientation="Horizontal" >
					<Label ToolTip.Tip="Ответ" ></Label>
					<StackPanel Orientation="Horizontal">


						<Button Background="GreenYellow" HorizontalAlignment="Left" VerticalAlignment="Top"
								Command="{Binding DataContext.AddAnswerOnMultipleChoiceQuestionWithOneAnswerCommand,
								 RelativeSource={RelativeSource AncestorType=UserControl}}" 
								 CommandParameter="{Binding}" Width="30" Height="30">
							<TextBlock FontSize="15">+</TextBlock>
						</Button>
						
						

						<ItemsControl  x:DataType="dataTypes:MultipleChoiceQuestionWithOneAnswer" 
									   ItemsSource="{Binding Answers, Mode=TwoWay}" 
									   ItemTemplate="{StaticResource CreateTest_AnswerTemplate}"/>

					</StackPanel>
				</StackPanel>

				
				<StackPanel  Grid.Column="1" Grid.Row="1" Margin="0 0 10 20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" >
					<Button Command="{Binding DataContext.DeleteQuestionCommand,
								 RelativeSource={RelativeSource AncestorType=UserControl}}"
								CommandParameter="{Binding}" Background="Red">Удалить</Button>
				</StackPanel>

			</Grid>
		</Border>
		
		
		
	</DataTemplate>

	<!--Шаблон для ответа в MultiQuestion-->
	<DataTemplate x:DataType="dataTypes:TextAnswer" x:Key="CreateTest_AnswerTemplate">		
		<StackPanel Orientation="Horizontal">
			<TextBox Text="{Binding Text}" Width="100"></TextBox>
			<RadioButton GroupName="{Binding QuestionId}" IsChecked="{Binding IsCorrect}"/>
			<Button Background="LightBlue" 
								Command="{Binding DataContext.DeleteAnswerOnMultipleChoiceQuestionWithOneAnswerCommand,
								 RelativeSource={RelativeSource AncestorType=UserControl}}"
								CommandParameter="{Binding}"
								Width="30" Height="30">
				<TextBlock FontSize="15">-</TextBlock>
			</Button>
		</StackPanel>
	</DataTemplate>

</ResourceDictionary>
